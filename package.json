{
  "name": "voiceflow-ai",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "main": "windows/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:android": "vite build && cap sync android",
    "build:apk": "cd android && .\\gradlew.bat assembleDebug",
    "build:apk:release": "vite build && cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "electron": "electron windows/electron/main.cjs",
    "start:windows": "electron windows/electron/main.cjs",
    "build:windows": "vite build && electron-builder --win portable",
    "build:exe": "vite build && electron-builder --win portable",
    "build:all": "vite build && cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.smartvoice.voiceflow",
    "productName": "VoiceFlow",
    "directories": {
      "output": "windows/release"
    },
    "files": [
      "dist/**/*",
      "windows/electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "windows/electron/icon.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
